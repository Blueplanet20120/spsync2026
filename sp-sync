#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_PY="$SCRIPT_DIR/tools/sync_to_gitee_local.py"

if [[ ! -f "$LOCAL_PY" ]]; then
  echo "sp-sync: missing $LOCAL_PY" >&2
  exit 1
fi

VENV_PY=""
if [[ -x "$SCRIPT_DIR/.venv/Scripts/python.exe" ]]; then
  VENV_PY="$SCRIPT_DIR/.venv/Scripts/python.exe"
elif [[ -x "$SCRIPT_DIR/.venv/bin/python" ]]; then
  VENV_PY="$SCRIPT_DIR/.venv/bin/python"
elif [[ -x "$SCRIPT_DIR/.venv/bin/python3" ]]; then
  VENV_PY="$SCRIPT_DIR/.venv/bin/python3"
fi
if [[ -n "$VENV_PY" ]]; then
  exec "$VENV_PY" "$LOCAL_PY" "$@"
fi

echo "sp-sync: 未找到 .venv，请先运行: python tools/setup_local_venv.py（或 ./setup_local_venv.cmd）" >&2

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$LOCAL_PY" "$@"
fi
if command -v python >/dev/null 2>&1; then
  exec python "$LOCAL_PY" "$@"
fi

echo "sp-sync: need python3 or python in PATH" >&2
exit 127
